// AzL Sonar config, every key explained. Copy to ./config/<cluster>.json (git-ignored) and fill in.
// Comments (// and /* */) are allowed: Sonar reads this file as is. Add-AzlSonarNode, Remove-AzlSonarNode and Set-AzlSonarConfig rewrite
// the file as plain JSON and drop the comments.
// Do not put passwords here: password, secret and secretValue under "credential" are refused.
// Easier: Start-AzlSonar.ps1 -InfrastructureFile ./infrastructure.yml builds all of this from the master file.
{
  // REQUIRED. The subscription of the cluster (a GUID). Infrastructure file: azure.subscription_id.
  "subscriptionId": "00000000-0000-0000-0000-000000000000",
  // REQUIRED. The resource group the cluster, the Arc machines and the deployment live in. azure.resource_group.
  "resourceGroup": "rg-example-azl",
  // Optional. The Azure region, shown in Details on the page (not used to reach Azure). Infrastructure file: azure.location.
  "location": "eastus",
  // REQUIRED. The Azure Local cluster name. cluster.name.
  "clusterName": "clus01",
  // REQUIRED. LocalIdentity (no Active Directory) or ActiveDirectory. scenario.identity: local_identity | active_directory.
  "identityModel": "LocalIdentity",
  // Optional, default "auto". simplified (simplified machine provisioning, azurelocal-ztp), oem-image (OEM image or ISO
  // plus Arc registration) or auto. scenario.os_install: simplified | iso.
  "provisioningRoute": "auto",
  // Optional, default true. The page needs a per-start access token (the URL Sonar prints carries it). false turns that off:
  // any account on this machine can then read the page. For a single-user machine only. -NoAccessToken does the same.
  "accessToken": true,
  // Optional, default none. A file Sonar writes the access token to at start (only the token; readable by the current user only;
  // removed when Sonar stops), so a script or an agent can read it instead of scraping the launch output. Relative to this file.
  // Start-AzlSonar.ps1 -TokenFile overrides it. Not with accessToken false. Left out here: the example runs unchanged.
  // "tokenFile": "./sonar.token",
  // Optional, default 4 (1 to 50). Live browser streams served at once; more get 429 and the page polls instead.
  "maxEventStreams": 4,
  // Optional, default 20. Seconds between Azure polls, 5 to 3600. Start-AzlSonar.ps1 -PollSeconds overrides it.
  "pollSeconds": 20,
  // Optional, default Standard. Standard or RackAware: what the page says about the shape of the deployment.
  "clusterPattern": "Standard",
  // Optional, default hyperconverged. hyperconverged or disaggregated.
  "architecture": "hyperconverged",
  // Optional, default "auto". auto, deployment, update, add-node or repair: which operation is followed after the deployment.
  "track": "auto",
  // Optional, default "auto". auto follows an update when Azure reports one; off never reads the update resources.
  "updateTrack": "auto",
  // Optional, default false. true says the deployment uses Internal DNS (preview, release 2609; Local Identity with Azure
  // Key Vault only): the page adds a note about it. It changes nothing Sonar reads.
  "internalDns": false,
  // Optional. API versions; the defaults are the current GA versions. Change only if Azure rejects them.
  "apiVersion": "2026-10-01",
  "apiVersionFallback": "2025-10-01",
  "edgeApiVersion": "2026-10-01",
  // REQUIRED, at least one node. In the infrastructure file: nodes[].name and the management address of the port with
  // role management and ip_assignment static (or dhcp_reservation).
  "nodes": [
    // name: the machine name. address: host name or IP address Sonar connects to for logs and the Arc probe.
    // seed: true on ONE node: the seed node, whose deployment logs are read (default: the first node, with a warning).
    // arcMachineName: optional; only when the Arc machine is named differently from the node.
    { "name": "node01", "address": "192.0.2.11", "seed": true },
    { "name": "node02", "address": "192.0.2.12" }
  ],
  // Optional. The event file azurelocal-ztp writes: <provisioning.simplified.evidence_path>/ztp-events.jsonl. Relative paths
  // are relative to this file. Without it the ZTP lines and per-machine ZTP steps are not shown.
  "ztpEvents": { "path": "D:\\Data\\azl-ztp\\example\\evidence\\ztp-events.jsonl" },
  // Optional. The event file the toolkit's OS configuration writes: <provisioning.simplified.evidence_path>/os-configuration-events.jsonl
  // (or the -EventLogPath of Invoke-AzureLocalOsConfiguration.ps1). Relative paths are relative to this file. Without it the
  // OS configuration mode shows no steps and no [osconfig] log lines.
  "osConfigEventsPath": "D:\\Data\\azl-ztp\\example\\evidence\\os-configuration-events.jsonl",
  // Optional. The event file the toolkit's ARM Validate and Deploy run writes: arm-deployment-events.jsonl in its -ReportDirectory
  // (default <temp>/azl-arm-<cluster>). Relative paths are relative to this file. Without it the Validate and Deployment modes show
  // only what Azure reports and there are no [arm] log lines.
  "armEventsPath": "D:\\Data\\azl-arm\\example\\arm-deployment-events.jsonl",
  // Optional. The event file (or the folder that holds it) of the toolkit's pre-cluster verification gate: precluster-verification-events.jsonl in its
  // report directory (default <environment data>/arm-report/verification/live). Relative paths are relative to this file. Without it the Verification
  // mode shows nothing and there are no [verify] log lines.
  "verificationEventsPath": "D:\\Data\\azl-ztp\\example\\evidence\\arm-report\\verification\\live\\precluster-verification-events.jsonl",
  // Optional. The folder the toolkit's Invoke-HardwareDiscovery.ps1 wrote with -OutputPath (<ServiceTag>.json per node and discovery-summary.json),
  // or one of those files. The Discovery stage (before ZTP) shows what it found. Relative paths are relative to this file.
  // Optional. Which stage to watch: Auto (default, the whole flow) or one of Discovery, Provisioning, OsConfiguration, Verification, Validate,
  // Deployment, Update, AddNode, Repair. A single monitor shows only its tile and reads only what it needs. -Monitor overrides it.
  "monitor": "Auto",
  "discoveryPath": "D:\\Data\\azl-ztp\\example\\evidence\\discovery",
  // Optional. Which account reads a node's logs: "local" while it is a workgroup machine, "domain" once the OS configuration has reported
  // DomainJoined and DomainAdminsConfigured. Only names and a keyvault:// reference for the password; a password in the file is refused.
  // The reference is keyvault://<vault>/<secret>, optionally /<version> (32 hex characters) to pin the secret version; an invalid one is
  // refused at load. maxRejections (1 to 5, default 2): rejections of the domain account before Sonar stops trying it until its password
  // changes. Sonar never uses the LCM user.
  // "logAccounts": { "local": { "username": "azl-admin" }, "domain": { "netbios": "IIC", "username": "svc-join", "passwordRef": "keyvault://kv-example/svc-join-password", "maxRejections": 2 } },
  // Optional. Append the run to this recording (JSON Lines). Start-AzlSonar.ps1 -Record overrides it.
  // "recordPath": "./recordings/clus01.jsonl",
  // Optional. Where the deployment logs are read on the seed node. The defaults are shown.
  "logs": {
    "paths": [
      "C:\\CloudContent\\MASLogs",
      "C:\\MASLogs",
      "C:\\CloudDeployment\\Logs",
      "C:\\Observability",
      "C:\\Windows\\System32\\Bootstrap\\Logs"
    ],
    "include": ["*.log", "*.txt", "*.xml"],   // file name patterns to follow
    "exclude": ["*.etl"],                      // patterns to skip (may be empty)
    "recurseDepth": 3,                         // 0 to 10, folder levels below each path
    "activeWindowMinutes": 30,                 // 1 to 10080, a file is "active" if written within this time
    "maxLinesPerPoll": 500,                    // 1 to 10000
    "pollSeconds": 20,                         // 1 to 3600, default: pollSeconds above
    "transport": "auto"                        // auto, winrm or ssh
  },
  // Optional, default {"source": "prompt"}: which account reads the logs on the seed node.
  // prompt: Sonar asks at start. parameter: give -Credential to Start-AzlSonar.ps1. keyvault: read the NAMES below
  // from Key Vault (vault, usernameSecret, passwordSecret are names, never values).
  "credential": { "source": "prompt" }
}
